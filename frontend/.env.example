# ============================================================
# TradingCalculator.pro — Frontend Environment Variables
# Set these as Secrets in GitHub → Settings → Secrets → Actions
# ============================================================

# URL del backend en Google Cloud Run (sin /api al final)
REACT_APP_BACKEND_URL=https://your-cloud-run-service-url.run.app

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=

# Google Analytics (opcional)
REACT_APP_GA4_MEASUREMENT_ID=

# Google Tag Manager (opcional)
REACT_APP_GTM_ID=

# Google Search Console verification (opcional)
REACT_APP_GSC_VERIFICATION=

# Bing Webmaster Tools verification (opcional)
REACT_APP_BING_VERIFICATION=

# ── Google AdSense (opcional) ────────────────────────────────────────
# Publicidad SÓLO en el contenido gratuito. Si REACT_APP_ADSENSE_CLIENT está
# vacío no se carga nada: ni script, ni huecos, ni ads.txt.
# Quien tiene suscripción Premium NUNCA ve anuncios (ver src/lib/adsPolicy.js).
# En GitHub estas cuatro van como *variables* del repositorio, no como secretos:
# el ID de editor viaja en el HTML de cada página.
# Guía completa: docs/MONETIZACION_ADS.md
REACT_APP_ADSENSE_CLIENT=
REACT_APP_ADSENSE_SLOT_ARTICLE=
REACT_APP_ADSENSE_SLOT_BOTTOM=
# 'google' si el consentimiento lo gestiona la CMP certificada de Google
# (AdSense → Privacidad y mensajes). Vacío = manda nuestro banner de cookies.
REACT_APP_ADSENSE_CMP=

# Fix para Node 17+ con OpenSSL
NODE_OPTIONS=--openssl-legacy-provider
