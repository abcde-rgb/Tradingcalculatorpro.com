# ===========================================================
# TradingCalculator.pro — Backend Environment Variables
# Copy this file to .env and fill in all values
# ===========================================================

# ---- DATABASE -----------------------------------------------
# PostgreSQL connection URL (asyncpg format)
# Google Cloud SQL: postgresql://user:password@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
# Local dev:        postgresql://user:password@localhost:5432/trading_calculator_pro
DATABASE_URL=postgresql://user:password@localhost:5432/trading_calculator_pro

# ---- SECURITY (REQUIRED in production) ----------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- DEMO USER ----------------------------------------------
DEMO_EMAIL=demo@btccalc.pro
DEMO_PASSWORD=1234

# ---- GOOGLE OAUTH -------------------------------------------
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ---- STRIPE (payments) --------------------------------------
STRIPE_API_KEY=sk_test_...

# ---- SENDGRID (email alerts) --------------------------------
SENDGRID_API_KEY=
SENDER_EMAIL=alerts@tradingcalculator.pro

# ---- CORS ---------------------------------------------------
FRONTEND_URL=https://abcde-rgb.github.io/Tradingcalculatorpro.com
CORS_ORIGINS=https://abcde-rgb.github.io
