# ===========================================================
# TradingCalculator.pro — Backend Environment Variables
# ===========================================================

# ---- DATABASE (Google Cloud SQL) ----------------------------
# Formato para Cloud Run (Unix socket — recomendado):
# postgresql://USUARIO:PASSWORD@/NOMBRE_BD?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Ejemplo:
# DATABASE_URL=postgresql://trading_user:mipassword@/trading_db?host=/cloudsql/tradingcalculator-123456:europe-west1:trading-db
#
# Formato para desarrollo local (TCP):
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_calculator_pro
DATABASE_URL=

# ---- SECURITY -----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- DEMO USER ----------------------------------------------
DEMO_EMAIL=demo@btccalc.pro
DEMO_PASSWORD=1234

# ---- GOOGLE OAUTH -------------------------------------------
GOOGLE_CLIENT_ID=

# ---- STRIPE (payments) --------------------------------------
STRIPE_API_KEY=sk_test_...

# ---- SENDGRID (email alerts) --------------------------------
SENDGRID_API_KEY=
SENDER_EMAIL=alerts@tradingcalculator.pro

# ---- CORS ---------------------------------------------------
FRONTEND_URL=https://abcde-rgb.github.io/Tradingcalculatorpro.com
CORS_ORIGINS=https://abcde-rgb.github.io
