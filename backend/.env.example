# ===========================================================
# TradingCalculator.pro — Backend Environment Variables
# Copy to .env and fill in the values before running.
# ===========================================================

# ---- DATABASE (PostgreSQL) ----------------------------------
# Opción A — Neon (recomendado, TCP+SSL). Usa la cadena DIRECTA (sin "-pooler")
# para que asyncpg funcione con prepared statements. Ejemplo (NO son credenciales reales):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
#
# Opción B — Google Cloud SQL (socket Unix en producción):
# DATABASE_URL=postgresql://USUARIO:PASSWORD@/NOMBRE_BD?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
#
# Local development (TCP):
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_calculator_pro
DATABASE_URL=

# ---- SECURITY -----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Fernet key for encrypting API secrets stored in DB (recommended)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ---- DEMO USER ----------------------------------------------
DEMO_EMAIL=demo@btccalc.pro
# Must be at least 8 characters — change this in production
DEMO_PASSWORD=change_this_in_production

# ---- GOOGLE OAUTH -------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ---- STRIPE (payments) --------------------------------------
# Secret key from Stripe Dashboard → Developers → API keys
STRIPE_API_KEY=sk_live_...
# Signing secret from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- SENDGRID (transactional email) -------------------------
# From SendGrid → Settings → API Keys
SENDGRID_API_KEY=SG....
# Must be a verified sender in SendGrid
SENDER_EMAIL=alerts@tradingcalculatorpro.com

# ---- AI (Claude trade coach) --------------------------------
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Alternative key name (fallback)
# EMERGENT_LLM_KEY=sk-ant-...

# ---- CORS / FRONTEND ----------------------------------------
# Public URL of the frontend (used in emails and HSTS logic)
FRONTEND_URL=https://abcde-rgb.github.io/Tradingcalculatorpro.com
# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGINS=https://abcde-rgb.github.io,https://tradingcalculatorpro.com
