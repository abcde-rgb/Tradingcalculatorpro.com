# ===========================================================
# TradingCalculator.pro — Backend Environment Variables
# Copy to .env and fill in the values before running.
# ===========================================================

# ---- DATABASE (Google Cloud SQL) ----------------------------
# Cloud Run / Unix socket (recommended for production):
# DATABASE_URL=postgresql://USUARIO:PASSWORD@/NOMBRE_BD?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# Example:
# DATABASE_URL=postgresql://trading_user:mipassword@/trading_db?host=/cloudsql/tradingcalculator-495806:us-central1:trading-db
#
# Local development (TCP):
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_calculator_pro
DATABASE_URL=

# ---- SECURITY -----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Fernet key for encrypting API secrets stored in DB (recommended)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ---- DEMO USER ----------------------------------------------
DEMO_EMAIL=demo@btccalc.pro
# Must be at least 8 characters — change this in production
DEMO_PASSWORD=change_this_in_production

# ---- GOOGLE OAUTH -------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ---- RAÍLES DE COBRO ACTIVOS --------------------------------
# Qué métodos se pueden usar, separados por comas. Vacío = los de siempre
# (card,sepa,klarna,paypal,revolut,nowpayments). Nunca deja la web sin cobrar:
# una lista ilegible vuelve al valor por defecto. Ver docs/PASARELA_KUNFUPAY.md § 14.
# PAYMENT_METHODS_ENABLED=paypal,revolut,nowpayments,kunfupay

# ---- KUNFUPAY (enlaces de cobro, sin API) -------------------
# Kunfupay no publica API ni webhooks: se cobra en su enlace hospedado y el alta
# la confirma un admin en /api/admin/payments/manual. JSON plan → enlace https.
# KUNFUPAY_LINKS={"annual":"https://shops.kunfupay.com/...","lifetime":"https://shops.kunfupay.com/..."}

# ---- STRIPE (payments) --------------------------------------
# Secret key from Stripe Dashboard → Developers → API keys
STRIPE_API_KEY=sk_live_...
# Signing secret from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- SENDGRID (transactional email) -------------------------
# From SendGrid → Settings → API Keys
SENDGRID_API_KEY=SG....
# Must be a verified sender in SendGrid
SENDER_EMAIL=alerts@tradingcalculator.pro

# ---- AI (Claude trade coach) --------------------------------
# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Alternative key name (fallback)
# EMERGENT_LLM_KEY=sk-ant-...

# ---- CORS / FRONTEND ----------------------------------------
# Public URL of the frontend (used in emails and HSTS logic)
FRONTEND_URL=https://tradingcalculator.pro
# Comma-separated list of allowed CORS origins (no trailing slash)
# El dominio propio y su www ya van por código; esta variable sólo AÑADE.
# Nunca pongas aquí tradingcalculatorpro.com: es de un tercero.
CORS_ORIGINS=https://www.tradingcalculator.pro

# ── Passkeys (WebAuthn) ─────────────────────────────────────────────────────
# Se DERIVAN de FRONTEND_URL si no se fijan, y ahí está el peligro: un
# `gcloud run deploy` sin --set-env-vars borra FRONTEND_URL, el rp_id cambia y
# TODA passkey ya registrada deja de validar. WebAuthn ata cada credencial a su
# dominio a propósito, así que no se pueden migrar: los usuarios tendrían que
# registrarlas de nuevo. Fíjalos explícitamente.
PASSKEY_RP_ID=tradingcalculator.pro
PASSKEY_ORIGIN=https://tradingcalculator.pro
